{
    "name": "horde/kolab_filter",
    "description": "Kolab server Postfix filters library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Gunnar Wrobel",
            "email": "p@rdus.de",
            "role": "lead"
        }
    ],
    "time": "2026-06-27",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/core": "^3 || dev-FRAMEWORK_6_0",
        "horde/icalendar": "^3 || dev-FRAMEWORK_6_0",
        "horde/argv": "^3 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/mime": "^3 || dev-FRAMEWORK_6_0",
        "horde/smtp": "^2 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "horde/kolab_server": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/notification": "^3 || dev-FRAMEWORK_6_0",
        "horde/prefs": "^3 || dev-FRAMEWORK_6_0",
        "horde/test": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Kolab_Filter": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Kolab\\Filter\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "0.x-dev"
        }
    }
}